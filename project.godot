; Engine configuration file.
; Hand-authored for M0-01. Godot rewrites this file when the editor saves, so
; keep changes here small and check the diff — spec §11, ARCH §2.

config_version=5

[application]

config/name="COIL"
config/description="Snake-arena game. Offline-first, bots, landscape only."
config/features=PackedStringArray("4.7", "C#", "Mobile")

; M0-03 needs a scene to launch into to prove .NET runs on the handset at all.
; Throwaway — M0-12 repoints this at the real arena host.
run/main_scene="res://game/arena.tscn"

[display]

; 1280x720 design resolution with canvas_items stretch — the arena is authored
; at this size and scaled to whatever the handset reports. Roadmap M0-01.
window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

; Landscape only — D-08. sensor_landscape so the phone may be held either way up.
window/handheld/orientation="sensor_landscape"

[dotnet]

project/assembly_name="Coil"

[rendering]

; Forward Mobile — spec §11. The desktop editor falls back to the same method so
; what is seen in the editor is what the handset renders.
renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"

; Required by the Android exporter, which refuses to package without it — the
; handset's GPU decodes ETC2/ASTC, and an APK of raw textures would not fit the
; budget in spec §11 anyway. Roadmap M0-03.
textures/vram_compression/import_etc2_astc=true

[physics]

; Spec §11.3 and ARCH §4. These mirror Appendix A's TICK_RATE and
; MAX_CATCHUP_TICKS, and SimConfigTests fails if they drift apart — the engine
; defaults to 8 catch-up steps, which is a spiral this project has ruled out.
common/physics_ticks_per_second=60
common/max_physics_steps_per_frame=5
