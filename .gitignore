# Godot 4 (.NET) — COIL

# Engine-generated. Contains the import cache and the mono build temp dirs;
# regenerated on first open. Godot.NET.Sdk creates one per SDK project, so this
# has to match at any depth, not just the repo root.
.godot/
.mono/

# .NET build output
bin/
obj/
*.user
*.swp

# Godot export output
build/
export/
*.apk
*.aab
*.pck
*.zip

# Signing material — never in the repo, on any branch.
# NOTE for M0-03: Godot writes keystore user/password into export_presets.cfg
# when they are set in the export dialog. That file IS committed, so the
# credentials must come from the environment or editor settings instead.
*.keystore
*.jks
*.p12
*.pfx
*.pepk
key.properties

# Godot Android build template (generated by the editor, large, reproducible)
android/build/
android/.build_version

# Claude Code local overrides — machine-specific, not project config.
.claude/settings.local.json

# OS noise
.DS_Store
Thumbs.db
