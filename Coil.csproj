<Project Sdk="Godot.NET.Sdk/4.5.2">

  <!--
    The game assembly Godot loads. It sits at the repo root next to
    project.godot because Godot requires that, and it references the three
    libraries in src/ — ARCH §2.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Coil</RootNamespace>
    <AssemblyName>Coil</AssemblyName>
  </PropertyGroup>

  <!--
    Godot.NET.Sdk globs **/*.cs from the project directory, which is the repo
    root. Without these removes the library sources would compile into the game
    assembly as well as their own, and every type would collide.
  -->
  <ItemGroup>
    <Compile Remove="src/**" />
    <Compile Remove="tests/**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="src/Coil.Sim/Coil.Sim.csproj" />
    <ProjectReference Include="src/Coil.Agents/Coil.Agents.csproj" />
    <ProjectReference Include="src/Coil.Presentation/Coil.Presentation.csproj" />
  </ItemGroup>

</Project>
