<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The simulation's test project — CONVENTIONS §3, D-11.

    Plain net8.0 and a reference to Coil.Sim only. It deliberately does NOT use
    Godot.NET.Sdk: `dotnet test` must boot no engine and open no window, which
    is what keeps the suite fast enough to run on every commit. M0-09 adds the
    NetArchTest rules to this same project.

    xunit.v3 runs on Microsoft.Testing.Platform, so the test assembly is its own
    executable and `dotnet test` needs no VSTest host to start. The opt-in that
    makes `dotnet test` use it lives in global.json — on the .NET 10 SDK the old
    per-project TestingPlatformDotnetTestSupport bridge is an error, not a route.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Coil.Sim.Tests</RootNamespace>
    <AssemblyName>Coil.Sim.Tests</AssemblyName>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NetArchTest.Rules" Version="1.3.2" />
    <PackageReference Include="xunit.v3" Version="4.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Coil.Sim/Coil.Sim.csproj" />

    <!--
      Coil.Agents is referenced only so the architecture rules can load it:
      ARCH §9 asserts Coil.Agents does not depend on Coil.Presentation, and a
      rule that cannot see the assembly cannot enforce it (M0-09).

      Coil.Presentation is deliberately NOT referenced. The rule forbidding it
      is proved against a planted violation in Violations/ instead, so this
      project never acquires the dependency it exists to forbid.
    -->
    <ProjectReference Include="../../src/Coil.Agents/Coil.Agents.csproj" />
  </ItemGroup>

  <!--
    The balance resource is the presentation layer's file, but its contents are
    a simulation contract: SimConfigTests reads it as text to prove every
    Appendix A constant is present, without booting an engine to deserialise it.
  -->
  <ItemGroup>
    <None Include="../../data/balance.tres" Link="balance.tres" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../project.godot" Link="project.godot" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
